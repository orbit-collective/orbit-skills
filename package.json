{
  "name": "@orbit-collective/skills",
  "version": "0.1.1",
  "description": "Install and safely manage official Orbit skills for AI coding agents",
  "keywords": [
    "orbit",
    "cli",
    "codex",
    "claude-code",
    "skills",
    "agents",
    "ai"
  ],
  "homepage": "https://github.com/orbit-collective/orbit-skills#readme",
  "bugs": {
    "url": "https://github.com/orbit-collective/orbit-skills/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbit-collective/orbit-skills.git"
  },
  "license": "MIT",
  "author": "Adiksuu",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "bin": {
    "orbit-skills": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "documentation",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "RELEASING.md"
  ],
  "scripts": {
    "clean": "node scripts/release/clean.mjs",
    "build": "npm run clean && tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "validate:catalog": "node scripts/release/validate-catalog.mjs",
    "check:package": "node scripts/release/check-package.mjs",
    "test:artifact": "node scripts/release/test-tarball.mjs",
    "test:package": "node scripts/release/pack-and-test.mjs",
    "release:verify": "npm run typecheck && npm test && npm run validate:catalog && npm run check:package",
    "prepack": "npm run release:verify",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1"
  }
}
